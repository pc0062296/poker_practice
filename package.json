{
  "name": "poker-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-player 9-max No-Limit Hold'em cash game trainer.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:full": "FULL_TESTS=1 vitest run",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "io.github.pc0062296.pokerpractice",
    "productName": "PokerPractice",
    "copyright": "Personal practice tool",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "PokerPractice-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "PokerPractice-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Poker Practice",
      "uninstallDisplayName": "Poker Practice"
    }
  }
}
